pkgname=linux-arctis-manager-git
pkgver=0  # populated by pkgver() below
pkgrel=1
pkgdesc="SteelSeries Arctis manager for Linux — git build from main"
arch=('x86_64')
url="https://github.com/elegos/Linux-Arctis-Manager"
license=('MIT')
depends=('python' 'libcap')
makedepends=('rust' 'cargo' 'uv' 'python' 'git')
provides=('linux-arctis-manager')
conflicts=('linux-arctis-manager')
install=lam.install
source=("$pkgname::git+https://github.com/elegos/Linux-Arctis-Manager.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    # e.g. v3.0.0-15-gabcdef1  →  3.0.0.r15.gabcdef1
    git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
    cd "$pkgname"
    make build PREFIX=/usr
}

package() {
    cd "$pkgname"
    make install PREFIX=/usr DESTDIR="$pkgdir"
}
