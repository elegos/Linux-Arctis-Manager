# Maintainer: Giacomo Furlan <g.furlan@accenture.com>
pkgbase=linux-arctis-manager
pkgname=(linux-arctis-manager linux-arctis-manager-plasma-widget)
pkgver=3.0.0alpha1
pkgrel=1
arch=('x86_64')
url="https://github.com/elegos/Linux-Arctis-Manager"
license=('MIT')
makedepends=('rust' 'cargo' 'python')
# Update tag and sha256sum for each release.
source=("$pkgbase-$pkgver.tar.gz::https://github.com/elegos/Linux-Arctis-Manager/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "Linux-Arctis-Manager-${pkgver}"
    make build PREFIX=/usr
}

package_linux-arctis-manager() {
    pkgdesc="SteelSeries Arctis manager for Linux — replaces SteelSeries GG with a native daemon and Qt6 GUI"
    depends=('python' 'libcap' 'openssl' 'systemd-libs' 'hicolor-icon-theme')
    # python-pytorch: only for the AI voice changer's one-shot .pth -> ONNX
    # conversion tool (E10-S6a/S7); optdepends is informational only on Arch
    # (pacman never auto-installs it), so runtime detection with a
    # consent-gated pip fallback is the primary mechanism here, not this line.
    optdepends=('python-pytorch: AI voice changer model conversion')
    provides=('linux-arctis-manager')
    conflicts=('linux-arctis-manager-git')
    install=lam.install

    cd "Linux-Arctis-Manager-${pkgver}"
    make install-core PREFIX=/usr DESTDIR="$pkgdir"
}

package_linux-arctis-manager-plasma-widget() {
    pkgdesc="KDE Plasma widget for linux-arctis-manager — status and configurable quick settings in the Plasma panel"
    # No compiled code in this one — same package for every arch.
    arch=('any')
    depends=('linux-arctis-manager' 'plasma-workspace')

    cd "Linux-Arctis-Manager-${pkgver}"
    make install-plasmoid PREFIX=/usr DESTDIR="$pkgdir"
}
