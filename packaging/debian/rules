#!/usr/bin/make -f
export DH_VERBOSE = 1
# rustup installs here; needs to be visible to every recipe below, not just
# the one that runs it.
export PATH := $(HOME)/.cargo/bin:$(PATH)

%:
	dh $@

override_dh_auto_build:
	# Debian stable's own rustc is routinely behind this project's MSRV
	# (transitive deps such as ort/zbus/icu_* already need newer than
	# Debian 13's 1.85) — same reason cargo/rustc aren't Build-Depends:
	# below. rustup keeps this working across Debian/Ubuntu/Mint alike
	# instead of chasing each release's packaged rustc version.
	command -v cargo >/dev/null || \
		curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
	make build PREFIX=/usr

override_dh_auto_install:
	# Stage into debian/tmp (not debian/linux-arctis-manager directly): two
	# binary packages now share this one install (see
	# linux-arctis-manager.install and
	# linux-arctis-manager-plasma-widget.install), and dh_install (run
	# automatically by `dh $@` below) fans debian/tmp out into each
	# package's own directory per those files.
	make install DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr

override_dh_shlibdeps:
	# The venv bundles its own private Qt6/ffmpeg/icu .so files (PySide6's
	# wheel vendors them) — they're not public shared libraries this
	# package provides, and dpkg-shlibdeps hard-fails trying to resolve
	# *their* runtime deps (libGL.so.1, libxkbcommon.so.0, ...) against
	# the build container instead of a real desktop system. Real binaries
	# (lam-daemon, lam-hidraw-helper) live outside the venv and are
	# unaffected by the exclude.
	dh_shlibdeps -X venv

override_dh_makeshlibs:
	# Same reason as override_dh_shlibdeps above: the venv's bundled .so
	# files aren't public shared libraries this package provides.
	dh_makeshlibs -X venv

override_dh_fixperms-arch:
	dh_fixperms
	chown root:root $(CURDIR)/debian/linux-arctis-manager/usr/libexec/lam-hidraw-helper
	setcap cap_dac_override+eip $(CURDIR)/debian/linux-arctis-manager/usr/libexec/lam-hidraw-helper
