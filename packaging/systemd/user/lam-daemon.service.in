[Unit]
Description=Linux Arctis Manager daemon
Documentation=https://github.com/Mic92/linux-arctis-manager
Requires=lam-hidraw-helper.service
After=lam-hidraw-helper.service

[Service]
Type=simple
ExecStart=@BINDIR@/lam-daemon
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info,lam_daemon::focus_monitor=debug

[Install]
WantedBy=default.target
